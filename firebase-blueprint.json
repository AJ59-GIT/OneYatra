{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile information and preferences.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string", "enum": ["M", "F", "O"] },
        "avatar": { "type": "string" },
        "loyaltyPoints": { "type": "number" },
        "walletBalance": { "type": "number" },
        "preferences": { "type": "object" },
        "addresses": { "type": "array" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["email", "name", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Stores MaaS booking information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "mode": { "type": "string" },
        "provider": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["CONFIRMED", "PENDING", "CANCELLED", "FAILED"] },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "mode", "amount", "status", "timestamp"]
    },
    "UserDocument": {
      "title": "User Document",
      "description": "Stores metadata for user uploaded documents (Passport, Aadhaar, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["PASSPORT", "VISA", "AADHAAR", "PAN", "VOTER_ID", "DRIVING_LICENSE", "OTHER"] },
        "number": { "type": "string" },
        "holderName": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "expiryDate": { "type": "string" },
        "fileUrl": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string", "enum": ["M", "F", "O"] },
        "sharedWith": { "type": "array" }
      },
      "required": ["id", "type", "number", "holderName", "isVerified"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents indexed by their Firebase Auth UID."
    },
    "/users/{userId}/documents/{docId}": {
      "schema": "UserDocument",
      "description": "Subcollection of documents belonging to a user."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Global collection of all bookings, accessible by admins."
    }
  }
}
